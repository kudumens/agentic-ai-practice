# Copy to .env and fill in the values.
#
# Generate real secrets with:
#   openssl rand -hex 32
#
# N8N_ENCRYPTION_KEY must be backed up: without it, saved credentials cannot
# be decrypted.

# n8n secrets
N8N_USER_MANAGEMENT_JWT_SECRET=
N8N_ENCRYPTION_KEY=

# n8n URLs
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/

# PostgreSQL settings
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# Timezone
GENERIC_TIMEZONE=Africa/Accra